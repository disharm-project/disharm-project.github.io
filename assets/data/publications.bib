% DISHARM publications: the single source for both lists.
%   - publications.html shows every entry, newest year first;
%   - index.html ("Recent publications") shows the three newest.
% Paste entries as exported from Google Scholar, ACL Anthology, DBLP, etc.
%
% Fields the site uses:
%   title, author, year, journal / booktitle (shown as the venue), abstract,
%   doi (adds a DOI link), url or pdf (adds a PDF link)
% The entry type sets the label: @article = Journal article,
% @inproceedings = Conference paper, @unpublished or an arXiv eprint = Preprint, ...
% The citation key becomes the anchor, e.g. publications.html#placeholder2026one

@article{placeholder2026one,
  title    = {[Publication title number one]},
  author   = {One, Author and Two, Author and Three, Author},
  journal  = {[Journal / venue name]},
  year     = {2026},
  abstract = {[Abstract placeholder: replace with the paper's actual abstract — the background, method, and main findings, typically 3-6 sentences.]}
}

@inproceedings{placeholder2025two,
  title     = {[Publication title number two]},
  author    = {One, Author and Two, Author},
  booktitle = {[Conference name]},
  year      = {2025},
  abstract  = {[Abstract placeholder: replace with the paper's actual abstract — the background, method, and main findings, typically 3-6 sentences.]}
}

@unpublished{placeholder2025three,
  title        = {[Publication title number three]},
  author       = {One, Author and Two, Author and Three, Author and Four, Author},
  howpublished = {[Preprint server]},
  year         = {2025},
  abstract     = {[Abstract placeholder: replace with the paper's actual abstract — the background, method, and main findings, typically 3-6 sentences.]}
}

